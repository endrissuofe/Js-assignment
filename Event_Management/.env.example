# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/eventhorizon

# JWT (login token)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Email verification
FRONTEND_URL=http://localhost:3000
VERIFICATION_TOKEN_EXPIRES_MINUTES=60

# SMTP (e.g. Gmail app password, Mailtrap, Ethereal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
EMAIL_FROM="EventHorizon <no-reply@eventhorizon.dev>"
